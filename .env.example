# Chave gratuita do Google Gemini: https://aistudio.google.com/apikey
# Sem esta chave a assistente funciona normalmente para todos os comandos
# locais; só a conversa livre (CHAT) e a classificação por IA ficam off.
GEMINI_API_KEY=coloque_sua_chave_aqui

# O nome do modelo muda com o tempo (a Google aposenta versões antigas).
# Se aparecer no terminal "404 ... model ... is no longer available", troque
# aqui pelo nome sugerido na própria mensagem de erro.
# Dica: modelos "-lite" (ex.: gemini-2.5-flash-lite) tem a MAIOR cota no tier
# gratuito e sao mais rapidos.
GEMINI_MODEL=gemini-3.5-flash-lite

# false = roteamento 100% local; gasta 1 requisicao a menos por pergunta.
AI_INTENT_CLASSIFICATION_ENABLED=true

# Limites de tempo (segundos) de espera pela API do Gemini. Se estourar, a
# classificacao cai para CHAT; a conversa tenta de novo (GEMINI_CHAT_RETRIES)
# e, se ainda falhar, da uma resposta curta de fallback. Perguntas complexas
# usam o timeout maior automaticamente.
GEMINI_CLASSIFY_TIMEOUT_SECONDS=4
GEMINI_CHAT_TIMEOUT_SECONDS=8
GEMINI_CHAT_COMPLEX_TIMEOUT_SECONDS=20
GEMINI_CHAT_RETRIES=2

# Teto de tokens da resposta falada (respostas curtas voltam mais rapido).
AI_MAX_OUTPUT_TOKENS=160
AI_MAX_OUTPUT_TOKENS_COMPLEX=500
